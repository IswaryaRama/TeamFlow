# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=teamflow_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/teamflow_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/teamflow_db

# Security & JWT
SECRET_KEY=supersecretkey_change_me_in_production_1234567890!@#$
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
PROJECT_NAME="TeamFlow API"
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
